#!/bin/sh
# Git runs hooks at the working tree root, but a hook invoked
# by hand starts wherever the caller is. Deriving the root
# from this script's own path runs the checks at the root
# either way.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 1

if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    echo "error: .venv not found. Run: python scripts/dev.py setup" >&2
    exit 1
fi

"$PYTHON" scripts/dev.py lint || exit $?
"$PYTHON" scripts/dev.py type
